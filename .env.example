# Jack and the Beanstalk — environment configuration
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must never be
# committed. On Render you set these same variables in the dashboard instead.

# --- Image provider ---------------------------------------------------------------
# Which provider backs the generation service: "mock", "openai", "gemini" or "nim".
# "mock" runs the whole app with zero network calls and no API key, so you can
# develop and test the UI offline.
#
# This choice is the operator's alone: it is made here, in the environment, and
# there is no control for it anywhere in the visitor-facing UI.
IMAGE_PROVIDER=mock

# OpenAI (the default real provider). Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Cheapest per-call figure OpenAI publishes: $0.00588 for a 1K output at
# quality=low (196 output tokens at $30 per 1M image output tokens).
# Move up a tier with quality=medium|high|xhigh|max if likeness needs it.
OPENAI_MODEL=gpt-image-2.5-flare
OPENAI_QUALITY=low

# Google Gemini — the alternative. Key: https://aistudio.google.com/apikey
# Only needed when IMAGE_PROVIDER=gemini. Note there is no free tier for image
# generation: you must enable billing, and since March 2026 that is a prepay
# plan with a $5 minimum.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-image

# NVIDIA NIM — the free one. Key: https://build.nvidia.com/settings/api-keys
# Only needed when IMAGE_PROVIDER=nim. The hosted tier is free to prototype
# with and rate limited to roughly 40 requests a minute; it is not a production
# SLA, and NVIDIA can change the limits or the catalogue without notice.
NIM_API_KEY=
# Image-editing models that take reference images. flux.2-klein-4b accepts up
# to 8 reference images and is the default; other ids from NVIDIA's catalogue
# are flux-3-image-klein, qwen-image-edit-2509 and qwen-image-edit-2511.
NIM_MODEL=flux.2-klein-4b
# The OpenAI-compatible endpoint. Change it only for a self-hosted NIM.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Force one output size (WIDTHxHEIGHT) instead of deriving it from the chosen
# aspect ratio. Leave empty to let the ratio decide.
NIM_SIZE=
# NIM's OpenAI-compatible schema caps the prompt at 800 characters, while this
# app writes longer ones. A longer prompt is condensed to its head and tail
# before it is sent; raise the cap only if your endpoint accepts more.
NIM_MAX_PROMPT_CHARS=800
# How many characters at the end of a condensed prompt are kept. The tail holds
# the negative constraints, so it survives the cut.
NIM_PROMPT_TAIL_CHARS=200

# --- App --------------------------------------------------------------------------
APP_ENV=development

# A shared password in front of the whole app. Leave it empty and the app is
# open to anyone who finds the URL — fine locally, reckless in production,
# because every image costs money. Set it and every visitor gets a login form
# at /login; a successful login lasts APP_SESSION_MAX_AGE_DAYS.
# Changing this value logs everyone out.
APP_PASSWORD=
# How long one successful login stays valid.
APP_SESSION_MAX_AGE_DAYS=7
# Wrong passwords allowed per client before that client is locked out of the
# login form for a quarter of an hour.
APP_LOGIN_MAX_ATTEMPTS=8

# Cap on upload size, in megabytes. Guards against someone POSTing a 2GB photo.
MAX_UPLOAD_MB=10

# Wall-clock ceiling for ONE /api/generate request, in seconds.
# This is a single budget covering both waiting for a free slot and the two
# model calls together, not one allowance each. The same value is applied to
# the provider's HTTP client, so a slow generation really does abort its socket
# rather than leaving a thread burning tokens in the background.
# Set high: two image calls should normally finish well inside it.
GENERATION_TIMEOUT_SECONDS=600

# How many generations may run at once per process. Requests beyond this queue;
# if one waits longer than its remaining budget it gets 429 and is told to
# retry, without any request reaching the image model and without costing you
# anything. Raise it only if your provider's rate limits allow more.
MAX_CONCURRENT_GENERATIONS=2
# Per-client billable request guard. Set higher only for a trusted/private demo.
MAX_GENERATIONS_PER_MINUTE=30

# Where generated artefacts are stored. Render's local disk is ephemeral, but
# this keeps the setting explicit and makes Docker/local runs predictable.
STORAGE_DIR=./storage
