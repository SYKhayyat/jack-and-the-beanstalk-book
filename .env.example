# Jack and the Beanstalk — environment configuration
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must never be
# committed. On Render you set these same variables in the dashboard instead.

# --- Image provider ---------------------------------------------------------------
# Which provider backs the generation service: "mock", "openai", "gemini" or
# "agnes".
# "mock" runs the whole app with zero network calls and no API key, so you can
# develop and test the UI offline.
#
# This choice is the operator's alone: it is made here, in the environment, and
# there is no control for it anywhere in the visitor-facing UI.
IMAGE_PROVIDER=mock

# OpenAI (the default real provider). Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Cheapest per-call figure OpenAI publishes: $0.00588 for a 1K output at
# quality=low (196 output tokens at $30 per 1M image output tokens).
# Move up a tier with quality=medium|high|xhigh|max if likeness needs it.
OPENAI_MODEL=gpt-image-2.5-flare
OPENAI_QUALITY=low

# Google Gemini — the alternative. Key: https://aistudio.google.com/apikey
# Only needed when IMAGE_PROVIDER=gemini. Note there is no free tier for image
# generation: you must enable billing, and since March 2026 that is a prepay
# plan with a $5 minimum.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-image

# Agnes AI — the free one that actually takes the uploaded photo. Key comes from
# the Agnes AI console; only needed when IMAGE_PROVIDER=agnes.
# Every resolution tier and every input reference image is currently free. The
# free tier is limited by resolution, not by a daily cap: about 10 requests a
# minute at 1K, 5 at 2K, and one per minute at 3K/4K. A finished book is twenty
# calls (one portrait plus nineteen story pages), so at 1K expect about two
# minutes of ceiling per book.
AGNES_API_KEY=
# The image model that accepts an array of reference images — the cartoonify
# pass sends the photo, the book pass sends the portrait plus the photo.
AGNES_MODEL=agnes-image-2.5-flash
# Output resolution tier: 1K, 2K, 3K or 4K. Stay at 1K on the free tier.
AGNES_SIZE=1K
# The OpenAI-compatible endpoint. Change it only if the service moves.
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# --- App --------------------------------------------------------------------------
APP_ENV=development
# --- Sign-in ---------------------------------------------------------------------
# Google sign-in (the way in, in production). Create the OAuth client in the
# Google Cloud console: see docs/google-oauth-setup.md for the click-by-click
# walkthrough. When BOTH of these are set, Google is the ONLY way in: the
# shared password below is switched off.
# Client id and secret come from the console; neither ever belongs in this
# repo, in a log line, or in a Slack message.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The exact redirect URI you registered in the console, e.g.
# https://jack-and-the-beanstalk-book.onrender.com/auth/callback
# Leave it empty for local development (the app derives it from the request).
GOOGLE_REDIRECT_URI=

# The key that signs the session cookie. Set it in production: without it the
# app derives one, which signs everyone out on every restart. It is NOT the
# password, so rotating a password no longer logs anybody out.
SESSION_SECRET=
# How long one successful sign-in stays valid.
APP_SESSION_MAX_AGE_DAYS=7

# A shared password in front of the whole app. LOCAL DEVELOPMENT ONLY: with a
# Google client configured (above) the password is switched off entirely.
# Leave it empty and the app is open to anyone who finds the URL — fine
# locally, reckless in production, because every image costs money.
APP_PASSWORD=
# Wrong passwords allowed per client before that client is locked out of the
# login form for a quarter of an hour.
APP_LOGIN_MAX_ATTEMPTS=8

# Cap on upload size, in megabytes. Guards against someone POSTing a 2GB photo.
MAX_UPLOAD_MB=10

# Wall-clock ceiling for ONE /api/generate request, in seconds.
# This is a single budget covering both waiting for a free slot and the two
# model calls together, not one allowance each. The same value is applied to
# the provider's HTTP client, so a slow generation really does abort its socket
# rather than leaving a thread burning tokens in the background.
# Set high: two image calls should normally finish well inside it.
GENERATION_TIMEOUT_SECONDS=600

# How many generations may run at once per process. Requests beyond this queue;
# if one waits longer than its remaining budget it gets 429 and is told to
# retry, without any request reaching the image model and without costing you
# anything. Raise it only if your provider's rate limits allow more.
MAX_CONCURRENT_GENERATIONS=2
# Per-client billable request guard. Set higher only for a trusted/private demo.
MAX_GENERATIONS_PER_MINUTE=30

# Where generated artefacts are stored. Render's local disk is ephemeral, but
# this keeps the setting explicit and makes Docker/local runs predictable.
STORAGE_DIR=./storage

# --- Database (optional) ---------------------------------------------------------
# A Postgres connection URL. Set it and books + signed-in people live in the
# database instead of on disk: a book survives a restart/redeploy, and every
# book is keyed to the person who made it.
#
# Neon (free tier) is the recommended host. Use the **pooled** connection
# string (the host with the "-pooler" suffix) for the web process. It embeds
# the database password, so it belongs in the environment only — never in
# this repo, never in a log line, never in a screenshot.
#
# After setting it for the first time, apply the schema once:
#     export DATABASE_URL=postgres://...
#     make migrate
#
# Leave it empty and the app runs exactly as before: everything on disk,
# offline, no database needed for local development or CI.
DATABASE_URL=
