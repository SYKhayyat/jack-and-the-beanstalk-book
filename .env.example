# Jack and the Beanstalk — environment configuration
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must never be
# committed. On Render you set these same variables in the dashboard instead.

# --- Image provider ---------------------------------------------------------------
# Which provider backs the generation service: "mock", "openai", "gemini" or
# "agnes".
# "mock" runs the whole app with zero network calls and no API key, so you can
# develop and test the UI offline.
#
# This choice is the operator's alone: it is made here, in the environment, and
# there is no control for it anywhere in the visitor-facing UI.
IMAGE_PROVIDER=mock

# OpenAI (the default real provider). Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Cheapest per-call figure OpenAI publishes: $0.00588 for a 1K output at
# quality=low (196 output tokens at $30 per 1M image output tokens).
# Move up a tier with quality=medium|high|xhigh|max if likeness needs it.
OPENAI_MODEL=gpt-image-2.5-flare
OPENAI_QUALITY=low

# Google Gemini — the alternative. Key: https://aistudio.google.com/apikey
# Only needed when IMAGE_PROVIDER=gemini. Note there is no free tier for image
# generation: you must enable billing, and since March 2026 that is a prepay
# plan with a $5 minimum.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-image

# The picture reviewer (T9 tier 2). Every finished page and cover is looked at
# by a vision model before a book can complete: a cheap mechanical check cannot
# tell whether the page shows the right moment, or whether a letter of text got
# drawn into the sky. Leave REVIEWER_API_KEY empty to use GEMINI_API_KEY.
# In production a missing key is a start-up error rather than a book that ships
# unreviewed; in development the reviewer is simply off and says so.
REVIEWER_API_KEY=
# The reviewer: openai (gpt-6-luna, about $0.0011 a review; uses OPENAI_API_KEY,
# so REVIEWER_API_KEY is ignored, and it sees the plate too) or gemini (free
# tier, which runs out of daily quota mid-book). off sends no picture to it, and
# the decision judge and tier 1 decide alone.
REVIEWER_PROVIDER=openai
REVIEWER_MODEL=gpt-6-luna
# One review's budget, and the decision judge's.
REVIEWER_TIMEOUT_SECONDS=90
# The decision judge (JEV-style first look). A decision model — OpenAI's
# Decisions API — answers seven yes/no questions about every picture with
# calibrated probabilities: confidently good pictures pass with no reviewer call,
# confidently bad ones fail (the reviewer only writes what to fix), and only the
# unsure ones go to the reviewer. Uses OPENAI_API_KEY; about 2,000 input tokens
# per picture at $0.10 per million, output free. Off in mock mode, or set false.
DECISION_JUDGE=true
DECISION_JUDGE_MODEL=gpt-6-luna
DECISION_JUDGE_USD_PER_MILLION_TOKENS=0.10
# openai, or gemini_web (free, local only: see GEMINI_WEB_* below).
DECISION_JUDGE_PROVIDER=openai
# Billable tries per page before the best one is kept (1-3). Each try costs
# money; a page that never passes is kept anyway and marked best-effort.
PAGE_ATTEMPTS=3

# What a call costs, for the cost ledger (average cost per book on /wallet).
# Empty IMAGE_CALL_COST_USD prices images from IMAGE_PROVIDER: agnes and mock
# are free, openai is priced from its published per-image table. Set it only
# for a model/quality that table does not know. Empty REVIEW_CALL_COST_USD
# counts review calls without pricing them. 0.0011 is the measured gpt-6-luna
# price of one review (a picture plus its plate).
IMAGE_CALL_COST_USD=
REVIEW_CALL_COST_USD=0.0011

# Agnes AI — the free one that actually takes the uploaded photo. Key comes from
# the Agnes AI console; only needed when IMAGE_PROVIDER=agnes.
# Every resolution tier and every input reference image is currently free. The
# free tier is limited by resolution, not by a daily cap: about 10 requests a
# minute at 1K, 5 at 2K, and one per minute at 3K/4K. A finished book is twenty
# calls (one portrait plus nineteen story pages), so at 1K expect about two
# minutes of ceiling per book.
AGNES_API_KEY=
# The image model that accepts an array of reference images — the cartoonify
# pass sends the photo, the book pass sends the portrait plus the photo.
AGNES_MODEL=agnes-image-2.5-flash
# Output resolution tier: 1K, 2K, 3K or 4K. Stay at 1K on the free tier.
AGNES_SIZE=1K
# The OpenAI-compatible endpoint. Change it only if the service moves.
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Gemini in a local Chrome — free, slow, and for test books on a dev machine
# only (`make local-book`). IMAGE_PROVIDER, REVIEWER_PROVIDER and
# DECISION_JUDGE_PROVIDER=gemini_web drive gemini.google.com in a dedicated
# Chrome profile through its debugging port. A job never fails for want of a
# person: signed out, the wrong account, a closed browser or a daily limit
# pauses it (with a desktop notice) and it resumes by itself.
# The Google account the profile must be signed into; checked before every job.
GEMINI_WEB_ACCOUNT=
GEMINI_WEB_PORT=9333
# Empty = ~/.local/share/jack-and-the-beanstalk/gemini-chrome
GEMINI_WEB_PROFILE_DIR=
GEMINI_WEB_CHROME=google-chrome
# How long to wait before trying again after Gemini says a limit is reached.
GEMINI_WEB_LIMIT_WAIT_SECONDS=1800

# --- App --------------------------------------------------------------------------
APP_ENV=development
# --- Sign-in ---------------------------------------------------------------------
# Google sign-in (the way in, in production). Create the OAuth client in the
# Google Cloud console: see docs/google-oauth-setup.md for the click-by-click
# walkthrough. When BOTH of these are set, Google is the ONLY way in: the
# shared password below is switched off.
# Client id and secret come from the console; neither ever belongs in this
# repo, in a log line, or in a Slack message.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The exact redirect URI you registered in the console, e.g.
# https://jack-and-the-beanstalk-book.onrender.com/auth/callback
# Leave it empty for local development (the app derives it from the request).
GOOGLE_REDIRECT_URI=

# The key that signs the session cookie. Set it in production: without it the
# app derives one, which signs everyone out on every restart. It is NOT the
# password, so rotating a password no longer logs anybody out.
SESSION_SECRET=
# How long one successful sign-in stays valid.
APP_SESSION_MAX_AGE_DAYS=7

# Who may use /admin: one or more Google `sub` values or account emails,
# comma separated (`you@example.com, 1122334455`). An email is easiest to
# copy from the Google account page; a sub is in Google's "sub" claim or the
# sign-in callback's log line. Sign in with that Google account, then the
# header shows an Operator link. Leave it empty and the admin screens are off
# (they answer 404, like any other unknown URL); admin is not something any
# visitor may do.
OPERATOR_SUB=

# A shared password in front of the whole app. LOCAL DEVELOPMENT ONLY: with a
# Google client configured (above) the password is switched off entirely.
# Leave it empty and the app is open to anyone who finds the URL — fine
# locally, reckless in production, because every image costs money.
APP_PASSWORD=
# Wrong passwords allowed per client before that client is locked out of the
# login form for a quarter of an hour.
APP_LOGIN_MAX_ATTEMPTS=8

# Cap on upload size, in megabytes. Guards against someone POSTing a 2GB photo.
MAX_UPLOAD_MB=10

# Wall-clock ceiling for ONE /api/generate request, in seconds.
# This is a single budget covering both waiting for a free slot and the two
# model calls together, not one allowance each. The same value is applied to
# the provider's HTTP client, so a slow generation really does abort its socket
# rather than leaving a thread burning tokens in the background.
# Set high: two image calls should normally finish well inside it.
GENERATION_TIMEOUT_SECONDS=600

# How many generations may run at once per process. Requests beyond this queue;
# if one waits longer than its remaining budget it gets 429 and is told to
# retry, without any request reaching the image model and without costing you
# anything. Raise it only if your provider's rate limits allow more.
MAX_CONCURRENT_GENERATIONS=4
# Per-client billable request guard. Set higher only for a trusted/private demo.
MAX_GENERATIONS_PER_MINUTE=200
# OpenAI image calls started per minute; calls wait for room instead of getting
# 429. Set just under your OpenAI images-per-minute limit (20 here). 0 = off.
OPENAI_IMAGES_PER_MINUTE=18

# Where generated artefacts are stored. Render's local disk is ephemeral, but
# this keeps the setting explicit and makes Docker/local runs predictable.
STORAGE_DIR=./storage

# Retention. Nothing is kept forever: an uploaded photo is a photograph of a
# child, and a finished book is twenty more of them.
# How long a draft (the uploaded photo, its cartoon portraits and the settings
# chosen) survives. The review flow needs minutes; the rest is slack for a
# slow visit. Expired on boot and hourly after that.
DRAFT_RETENTION_HOURS=24
# How long a finished (or failed) book is kept before its portrait, pages and
# PDF are deleted. Raise it for a demo where visitors come back days later.
BOOK_RETENTION_DAYS=7

# --- Payments (optional) ---------------------------------------------------------
# A Stripe **sandbox** secret key (sk_test_...) from the Stripe dashboard. Set it
# and every account gets a wallet: top it up through Stripe's hosted checkout,
# spend 99¢ per finished picture book, and send unspent money back to the card.
# It is a bearer credential — whoever holds it can move money on the account —
# so it belongs in the environment only, never in this repo or a log line.
#
# Leave it empty and money is off: books are made without a fee, there is no
# wallet page, and the app behaves exactly as before accounts had one.
STRIPE_SECRET_KEY=

# --- Database --------------------------------------------------------------------
# A Postgres connection URL. Set it and books, pages, PDFs, signed-in people
# and the story templates live in Postgres: a book survives a restart/redeploy,
# and every book is keyed to the person who made it.
#
# Neon (free tier) is the recommended host. Use the **pooled** connection
# string (the host with the "-pooler" suffix) for the web process. It embeds
# the database password, so it belongs in the environment only — never in
# this repo, never in a log line, never in a screenshot.
#
# Leave it empty and the app uses one SQLite file, `storage/app.sqlite3`. The
# app creates and migrates it when it boots, so local development and CI need
# no server. `make migrate` applies the same migrations ahead of time when a
# deploy wants to.
DATABASE_URL=

# Cloudflare R2: where pictures and PDFs live. Set all four and the database
# keeps only pointers (a few MB instead of hundreds); leave them empty and
# blobs stay inline in the database (local development, tests). The bucket
# must be PRIVATE and must not be put behind a CDN cache: these are children's
# portraits. Create an API token scoped to this bucket (Object Read & Write).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
